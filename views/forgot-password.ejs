<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <div class="login-shell">
    <div class="login-card">
      <a href="/" class="brand" style="margin-bottom:22px;"><img src="/images/logo.png" alt="BoriHomes" class="brand-logo" /> BoriHomes</a>
      <h2 style="margin-bottom:6px;">Forgot your password?</h2>
      <p style="margin-bottom:22px;">Enter the email on your agent account and we'll send you a link to choose a new password.</p>
      <div id="forgotAlert"></div>
      <form id="forgotForm">
        <div class="form-group"><label>Email</label><input class="form-control" type="email" name="email" required autocomplete="email" /></div>
        <button class="btn btn-primary btn-block" type="submit" id="forgotBtn">Send reset link</button>
      </form>
      <a href="/login" style="display:block;text-align:center;margin-top:16px;color:var(--ink-500);font-size:.85rem;">&larr; Back to login</a>
    </div>
  </div>
  <script>
    document.getElementById('forgotForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target, box = document.getElementById('forgotAlert'), btn = document.getElementById('forgotBtn');
      btn.disabled = true; btn.textContent = 'Sending…';
      try {
        const res = await fetch('/api/auth/forgot-password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Something went wrong. Please try again.');
        form.style.display = 'none';
        box.innerHTML = data.unavailable
          ? '<div class="alert alert-error">Resetting your password by email isn\'t switched on yet. Please contact BoriHomes and we\'ll help you: <strong>+234 903 475 0061</strong>, <strong>+234 907 893 0861</strong> or <strong>borihomes0@gmail.com</strong>.</div>'
          : '<div class="alert alert-success">If that email belongs to an agent account, we\'ve sent a link to reset your password. It works once and expires in 1 hour. Check your spam folder too.</div>';
      } catch (err) {
        const div = document.createElement('div'); div.className = 'alert alert-error'; div.textContent = err.message;
        box.innerHTML = ''; box.appendChild(div);
      } finally { btn.disabled = false; btn.textContent = 'Send reset link'; }
    });
  </script>
</body>
</html>
