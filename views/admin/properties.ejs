<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
  <h2 style="margin:0;">All Properties</h2>
</div>
<div class="table-wrap">
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th class="sortable" onclick="sortCtl.setSort('id')" id="th-id">ID</th>
          <th>Title</th>
          <th class="sortable" onclick="sortCtl.setSort('type')" id="th-type">Type</th>
          <th>Price</th>
          <th>Agent</th>
          <th>Rating</th>
          <th class="sortable" onclick="sortCtl.setSort('approval_status')" id="th-approval_status">Approval</th>
          <th class="sortable" onclick="sortCtl.setSort('created_at')" id="th-created_at">Listed</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="propRows"><tr><td colspan="10">Loading…</td></tr></tbody>
    </table>
  </div>
</div>
<script>
let allProperties = [];
let sortState, sortCtl;

document.addEventListener('DOMContentLoaded', () => {
  sortState = { field: null, dir: 'asc' };
  sortCtl = makeSortable(sortState, renderProperties);
  loadProperties();
});

async function loadProperties() {
  const res = await fetch('/api/admin/properties');
  const data = await res.json();
  allProperties = data.results;
  renderProperties();
}

function renderProperties() {
  ['id','type','approval_status','created_at'].forEach(f => {
    document.getElementById(`th-${f}`).textContent = sortCtl.headerLabel(f, {id:'ID',type:'Type',approval_status:'Approval',created_at:'Listed'}[f]);
  });
  const tbody = document.getElementById('propRows');
  if (!allProperties.length) { tbody.innerHTML = '<tr><td colspan="10">No properties.</td></tr>'; return; }
  const rows = sortCtl.sortRows(allProperties);
  tbody.innerHTML = rows.map(p => `
    <tr>
      <td><strong>${p.id}</strong></td>
      <td>${p.title}</td>
      <td>${p.type}</td>
      <td>${nairaFmt(p.price)}</td>
      <td>${p.agent || '<em>Unassigned</em>'}</td>
      <td>
        <input type="number" id="rating-${p.id}" value="${p.rating || ''}" placeholder="0–5" min="0" max="5" step="0.1"
          style="width:64px;padding:4px 6px;border-radius:6px;border:1px solid var(--ink-300);" />
      </td>
      <td>${statusPill(p.approval_status)}</td>
      <td>${new Date(p.created_at).toLocaleDateString()}</td>
      <td>
        <select onchange="updateStatus('${p.id}', this.value)" style="padding:4px 8px;border-radius:6px;border:1px solid var(--ink-300);">
          ${['Pending Approval','Available','Reserved','Rented','Unavailable'].map(s => `<option value="${s}" ${s===p.status?'selected':''}>${s}</option>`).join('')}
        </select>
      </td>
      <td style="white-space:nowrap;">
        ${p.approval_status === 'pending'
          ? `<button class="btn btn-sm btn-primary" onclick="approve('${p.id}')">Approve</button> <button class="btn btn-sm btn-danger" onclick="reject('${p.id}')">Reject</button>`
          : `<button class="btn btn-sm btn-outline" onclick="saveRating('${p.id}')">Save Rating</button>`}
        <a href="/properties/${p.id}" target="_blank" class="btn btn-sm btn-outline">View</a>
        <button class="btn btn-sm btn-danger" onclick="deleteProp('${p.id}')">Delete</button>
      </td>
    </tr>
  `).join('');
}
async function approve(id) {
  const ratingInput = document.getElementById(`rating-${id}`);
  const rating = ratingInput.value.trim();
  await fetch(`/api/admin/properties/${id}/approve`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(rating ? { rating } : {}),
  });
  loadProperties();
}
async function saveRating(id) {
  const rating = document.getElementById(`rating-${id}`).value.trim();
  if (!rating) return alert('Enter a rating between 0 and 5 first.');
  const res = await fetch(`/api/admin/properties/${id}/rating`, {
    method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ rating }),
  });
  if (!res.ok) { const r = await res.json(); alert(r.error || 'Failed to save rating.'); }
  loadProperties();
}
async function reject(id) { await fetch(`/api/admin/properties/${id}/reject`, {method:'PUT'}); loadProperties(); }
async function updateStatus(id, status) {
  await fetch(`/api/admin/properties/${id}/status`, { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify({status}) });
  loadProperties();
}
async function deleteProp(id) {
  if (!confirm(`Delete property ${id}? This cannot be undone.`)) return;
  await fetch(`/api/admin/properties/${id}`, { method: 'DELETE' });
  loadProperties();
}
</script>
