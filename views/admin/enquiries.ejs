<h2>All Enquiries</h2>
<div class="table-wrap">
  <div class="table-scroll">
    <table>
      <thead><tr><th>#</th><th>Property</th><th>Customer</th><th>Contact</th><th>Agent</th><th>Status</th></tr></thead>
      <tbody id="enqRows"><tr><td colspan="6">Loading…</td></tr></tbody>
    </table>
  </div>
</div>
<script>
async function loadEnquiries() {
  const res = await fetch('/api/admin/enquiries');
  const data = await res.json();
  document.getElementById('enqRows').innerHTML = data.results.map(e => `
    <tr>
      <td>#${e.id}</td>
      <td>${e.prop_code}<br/><span style="color:var(--ink-500);font-size:.8rem;">${e.title}</span></td>
      <td>${e.customer_name}</td>
      <td>${e.customer_phone}${e.customer_email ? '<br/>'+e.customer_email : ''}</td>
      <td>${e.agent_name || '<em>Unassigned</em>'}</td>
      <td>${statusPill(e.status)}</td>
    </tr>
  `).join('') || '<tr><td colspan="6">No enquiries yet.</td></tr>';
}
loadEnquiries();
</script>
