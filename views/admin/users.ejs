<h2>Users</h2>
<p style="color:var(--ink-500);font-size:.85rem;">All accounts with access to the system (admins and agents). Public visitors do not create accounts in Version 1.</p>
<div class="table-wrap">
  <div class="table-scroll">
    <table>
      <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Joined</th></tr></thead>
      <tbody id="userRows"><tr><td colspan="5">Loading…</td></tr></tbody>
    </table>
  </div>
</div>
<script>
async function loadUsers() {
  const res = await fetch('/api/admin/users');
  const data = await res.json();
  document.getElementById('userRows').innerHTML = data.results.map(u => `
    <tr>
      <td>${u.name}</td><td>${u.email}</td><td>${u.phone || ''}</td>
      <td><span class="pill ${u.role === 'admin' ? 'pill-green' : 'pill-amber'}">${u.role}</span></td>
      <td>${new Date(u.created_at).toLocaleDateString()}</td>
    </tr>
  `).join('') || '<tr><td colspan="5">No users.</td></tr>';
}
loadUsers();
</script>
