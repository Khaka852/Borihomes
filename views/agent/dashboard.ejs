<div class="stat-grid">
  <div class="stat-card"><div class="num"><%= stats.total %></div><div class="label">Assigned Properties</div></div>
  <div class="stat-card"><div class="num"><%= stats.available %></div><div class="label">Available</div></div>
  <div class="stat-card"><div class="num"><%= stats.rented %></div><div class="label">Rented</div></div>
  <div class="stat-card"><div class="num"><%= stats.newEnquiries %></div><div class="label">New Enquiries</div></div>
  <div class="stat-card"><div class="num"><%= stats.pendingInspections %></div><div class="label">Pending Inspections</div></div>
</div>
<div class="table-wrap" style="padding:20px;">
  <p style="margin:0;">Welcome back! Use <strong>My Properties</strong> to manage your listings, or <strong>Add Property</strong> to submit a new one for admin approval.</p>
</div>
