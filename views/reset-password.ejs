<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="referrer" content="no-referrer" />
  <meta name="robots" content="noindex" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <div class="login-shell">
    <div class="login-card">
      <a href="/" class="brand" style="margin-bottom:22px;"><img src="/images/logo.png" alt="BoriHomes" class="brand-logo" /> BoriHomes</a>
      <h2 style="margin-bottom:6px;">Choose a new password</h2>
      <p style="margin-bottom:22px;">At least 8 characters.</p>
      <div id="resetAlert"></div>
      <form id="resetForm">
        <div class="form-group">
          <label>New password</label>
          <div style="position:relative;">
            <input class="form-control" type="password" id="newPassword" minlength="8" maxlength="72" required autocomplete="new-password" style="padding-right:70px;" />
            <button type="button" id="toggleNewPassword" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--green-700);font-weight:600;cursor:pointer;">Show</button>
          </div>
        </div>
        <button class="btn btn-primary btn-block" type="submit" id="resetBtn">Save new password</button>
      </form>
    </div>
  </div>
  <script>
    const token = new URLSearchParams(window.location.search).get('token') || '';
    const box = document.getElementById('resetAlert'), form = document.getElementById('resetForm');
    function say(kind, html) { box.innerHTML = '<div class="alert alert-' + kind + '">' + html + '</div>'; }
    if (!token) { form.style.display = 'none'; say('error', 'This reset link is incomplete. Please open the link from your email again, or <a href="/forgot-password" style="color:inherit;text-decoration:underline;">request a new one</a>.'); }

    document.getElementById('toggleNewPassword').addEventListener('click', (e) => {
      const input = document.getElementById('newPassword'), reveal = input.type === 'password';
      input.type = reveal ? 'text' : 'password'; e.target.textContent = reveal ? 'Hide' : 'Show';
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('resetBtn'); btn.disabled = true; btn.textContent = 'Saving…';
      try {
        const res = await fetch('/api/auth/reset-password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token, password: document.getElementById('newPassword').value }) });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Something went wrong. Please try again.');
        form.style.display = 'none';
        say('success', 'Your password has been changed. You can log in with it now.');
        box.insertAdjacentHTML('beforeend', '<a href="/login" class="btn btn-primary btn-block">Go to login</a>');
      } catch (err) {
        const div = document.createElement('div'); div.className = 'alert alert-error'; div.textContent = err.message;
        box.innerHTML = ''; box.appendChild(div);
      } finally { btn.disabled = false; btn.textContent = 'Save new password'; }
    });
  </script>
</body>
</html>
