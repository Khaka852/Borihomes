<h2>Inspection Requests</h2>
<div class="table-wrap">
  <div class="table-scroll">
    <table>
      <thead><tr><th>#</th><th>Property</th><th>Customer</th><th>Date/Time</th><th>Status</th></tr></thead>
      <tbody id="inspRows"><tr><td colspan="5">Loading…</td></tr></tbody>
    </table>
  </div>
</div>
<script>
async function loadInspections() {
  const res = await fetch('/api/agent/inspections');
  const data = await res.json();
  const tbody = document.getElementById('inspRows');
  if (!data.results.length) { tbody.innerHTML = '<tr><td colspan="5">No inspection requests yet.</td></tr>'; return; }
  tbody.innerHTML = data.results.map(i => `
    <tr>
      <td>#${i.id}</td>
      <td>${i.prop_code}<br/><span style="color:var(--ink-500);font-size:.8rem;">${i.title}</span></td>
      <td>${i.customer_name}<br/>${i.customer_phone}</td>
      <td>${i.requested_date} at ${i.requested_time}</td>
      <td>
        <select onchange="updateInspection(${i.id}, this.value)" style="padding:4px 8px;border-radius:6px;border:1px solid var(--ink-300);">
          ${['Pending','Confirmed','Completed','Cancelled'].map(s => `<option value="${s}" ${s===i.status?'selected':''}>${s}</option>`).join('')}
        </select>
      </td>
    </tr>
  `).join('');
}
async function updateInspection(id, status) {
  await fetch(`/api/agent/inspections/${id}/status`, { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify({status}) });
  loadInspections();
}
loadInspections();
</script>
