<h2>Agent Applications</h2>
<p style="color:var(--ink-500);font-size:.85rem;max-width:640px;">People who applied via the public "Become an Agent" form. Review each one, contact them directly, then create their real account from the <a href="/admin/agents" style="color:var(--green-600);">Agents</a> page once approved.</p>
<div class="table-wrap">
  <div class="table-scroll">
    <table>
      <thead><tr><th>Name</th><th>Contact</th><th>Area(s)</th><th>Experience</th><th>Status</th></tr></thead>
      <tbody id="appRows"><tr><td colspan="5">Loading…</td></tr></tbody>
    </table>
  </div>
</div>
<script>
async function loadApplications() {
  const res = await fetch('/api/admin/agent-applications');
  const data = await res.json();
  const tbody = document.getElementById('appRows');
  if (!data.results.length) { tbody.innerHTML = '<tr><td colspan="5">No applications yet.</td></tr>'; return; }
  tbody.innerHTML = data.results.map(a => `
    <tr>
      <td>${a.full_name}</td>
      <td>${a.phone}${a.email ? '<br/>'+a.email : ''}</td>
      <td>${a.area_covered || '<em>Not specified</em>'}</td>
      <td style="max-width:260px;">${a.experience || ''}</td>
      <td>
        <select onchange="updateStatus(${a.id}, this.value)" style="padding:4px 8px;border-radius:6px;border:1px solid var(--ink-300);">
          ${['New','Contacted','Approved','Declined'].map(s => `<option value="${s}" ${s===a.status?'selected':''}>${s}</option>`).join('')}
        </select>
      </td>
    </tr>
  `).join('');
}
async function updateStatus(id, status) {
  await fetch(`/api/admin/agent-applications/${id}/status`, { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify({status}) });
  loadApplications();
}
loadApplications();
</script>
